<?xml version="1.0"?>
<ruleset name="FramesToWatch PMD"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        PMD rules for main sources.
    </description>

    <!-- PMD's standard Java rules -->
    <rule ref="category/java/errorprone.xml">
        <!-- Rules must be excluded in order to redefine/refine them -->
        <exclude name="MissingSerialVersionUID"/>
    </rule>

    <!-- Custom rules here -->
    <rule name="MissingSerialVersionUIDExceptExceptions"
          language="java"
          message="Serializable classes should declare serialVersionUID (exceptions are ignored)."
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <properties>
            <property name="xpath" value="
                //ClassDeclaration
                  [@Interface = false()]
                  [not(ends-with(@SimpleName, 'Exception'))]
                  [count(ClassBody/FieldDeclaration/VariableDeclarator/VariableId[@Name='serialVersionUID']) = 0]
                  [(ImplementsList | ExtendsList)/ClassType[pmd-java:typeIs('java.io.Serializable')]]
            "/>
        </properties>
    </rule>

</ruleset>